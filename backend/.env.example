# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/agrosmart?retryWrites=true&w=majority

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# OpenWeatherMap API
OPENWEATHER_API_KEY=your_openweathermap_api_key

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASSWORD=your_gmail_app_password   # Use Gmail App Password (not your main password)

# Anthropic API (for AI chat)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
